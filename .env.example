## Frontend build configuration (public values only)
API_BASE_URL=https://replace-with-api-url.example.com
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
AUTH_REDIRECT_URL=com.panenin.app://login-callback/
PASSWORD_RESET_REDIRECT_URL=com.panenin.app://reset-password/
WHATSAPP_PHONE_NUMBER=6281234567890

## Backend-only secrets belong in backend/.env or the deployment secret manager.
APP_NAME=Panenin API
APP_ENV=development
APP_DEBUG=false
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=
TEST_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PANENIN_AI_SERVICE_TOKEN_HASH=
PANENIN_AGENT_CONTRACT_VERSION=0.1.0
WHATSAPP_LINK_CODE_TTL_SECONDS=600
BOT_ACTION_TTL_SECONDS=600
ORDER_RESERVATION_TTL_SECONDS=86400
CONFIRMATION_CODE_PEPPER=

# WhatsApp gateway (runs as a separate process; never expose in Flutter).
PANENIN_CORE_API_URL=http://127.0.0.1:8000
PANENIN_CORE_ENABLED=true
PANENIN_AI_SERVICE_TOKEN=
WHATSAPP_SUBJECT_PEPPER=
FONNTE_TOKEN=
FONNTE_WEBHOOK_SECRET=
FONNTE_API_URL=https://api.fonnte.com
PUBLIC_WEBHOOK_URL=
WHATSAPP_DEMO_UI_ENABLED=true

# Optional external orchestration. The deterministic remote-control commands
# remain available if these services are disabled or unavailable.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSION=768
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=
